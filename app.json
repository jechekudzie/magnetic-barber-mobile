{
  "expo": {
    "name": "Magnetic Barbershop",
    "slug": "magnetic-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "magnetic",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0d0d",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.zw.magneticbarber.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Unlock the app with Face ID instead of signing in again."
      },
      "appleTeamId": "5L8YF2FA7C"
    },
    "android": {
      "package": "co.zw.magneticbarber.app",
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0d0d0d"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Magnetic needs your photos so you can send the shop a screenshot of your payment.",
          "cameraPermission": "Magnetic needs the camera so you can photograph your payment confirmation.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "armeabi-v7a"]
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "1949d8d4-2411-4b41-a506-acf0dc5b8939"
      }
    },
    "owner": "majecha",
    "updates": {
      "url": "https://u.expo.dev/1949d8d4-2411-4b41-a506-acf0dc5b8939"
    }
  }
}
